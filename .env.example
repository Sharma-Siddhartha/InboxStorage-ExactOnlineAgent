# Copy to .env on the ETL machine. Never commit .env.
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=
EXACT_REDIRECT_URI=
EXACT_BASE_URL=https://start.exactonline.nl
EXACT_TOKEN_FILE=C:/etl/secrets/exact_token.json   # refresh token rotates: stored outside the repo
EXACT_DIVISIONS=                                     # comma-separated division numbers

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=AGENT_EXACT_LOADER
SNOWFLAKE_ROLE=AGENT_EXACT_LOADER
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_PRIVATE_KEY_PATH=C:/etl/secrets/agent_exact_loader.p8

FINGERPRINT_KEY=      # secret for HMAC fingerprints of bank account numbers; long random value, never committed
GITHUB_REPO_PATH=C:/etl/repos/exact-agent
